# Copy to .env and adjust. The app reads DATABASE_URL at startup.

# PostgreSQL (after running scripts/setup_postgres.sql):
DATABASE_URL=postgresql+psycopg://sapfico:sapfico@localhost:5432/sapfico

# SQLite (zero-config default if DATABASE_URL is unset):
# DATABASE_URL=sqlite:///sapfico.db

DEFAULT_CLIENT=100
SQL_ECHO=false
